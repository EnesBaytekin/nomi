# ===============================================
# Nomi ortam değişkenleri
# Gizli anahtarları üretmek için:
#   openssl rand -base64 32
# Bu dosyayı binary'nin yanına ".env" olarak koyun
# veya değerleri doğrudan ortam değişkeni olarak verin.
# ===============================================

# ZORUNLU — JWT imza anahtarı (32 byte, base64)
JWT_SECRET=buraya-openssl-rand-base64-32

# ZORUNLU — Veri şifreleme ana anahtarı (32 byte, base64)
# DİKKAT: Bu anahtar kaybolursa şifreli veriler kurtarılamaz. Yedekleyin!
MASTER_KEY=buraya-openssl-rand-base64-32

# Sunucu
HOST=0.0.0.0
PORT=3000

# SQLite veritabanı dosya yolu
DB_PATH=./data/nomi.db

# Refresh token çerezi yalnızca HTTPS üzerinden taşınacak mı?
# İnternet üzerinden TLS (https) ile yayın yapacaksan true yap.
COOKIE_SECURE=false
