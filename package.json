{
  "name": "nomi",
  "version": "2.0.0",
  "private": true,
  "description": "Nomi — kişisel gider takibi (Go + gömülü React PWA, tek binary)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"go run .\" \"npm run dev --prefix web\"",
    "dev:server": "go run .",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "build:server": "go build -trimpath -ldflags \"-s -w\" -o nomi .",
    "start": "go run .",
    "typecheck": "npm run typecheck --prefix web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
